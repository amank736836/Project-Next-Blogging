# ──────────────────────────────────────────────
# Frame & Phrase — environment variables
# Copy this file to .env.local and fill in the values.
# ──────────────────────────────────────────────

# MongoDB connection string (required for build and API routes)
MONGO_URI=mongodb://127.0.0.1:27017/blog?serverSelectionTimeoutMS=1500

# MongoDB database name (optional, defaults to "blog")
MONGO_DB=blog

# Clerk authentication (required for build and all requests)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Cloudinary image upload (required for POST /api/upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# TinyMCE rich text editor (optional — shows a notice without it)
NEXT_PUBLIC_TINYMCE_API_KEY=your_tinymce_api_key
